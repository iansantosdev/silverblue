#!/usr/bin/bash

set -euo pipefail

CUSTOM_CONF="/etc/gdm/custom.conf"

if [[ -z "${STATE_DIRECTORY:-}" ]]; then
  echo "STATE_DIRECTORY is not set." >&2
  exit 1
fi

FIRST_USER=$(
  /usr/bin/getent passwd \
    | /usr/bin/awk -F: '$3 >= 1000 && $3 < 60000 && !found { print $1; found = 1 }'
)

if [[ -z "$FIRST_USER" ]]; then
  echo "No regular user found (UID >= 1000). Waiting for /etc/passwd to change."
  exit 0
fi

echo "Configuring autologin for user: $FIRST_USER"

/usr/bin/sed -i "/^AutomaticLogin=/c\AutomaticLogin=$FIRST_USER" "$CUSTOM_CONF"
/usr/bin/touch "$STATE_DIRECTORY/autologin-done"
