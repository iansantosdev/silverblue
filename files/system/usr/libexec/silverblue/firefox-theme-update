#!/usr/bin/bash

set -euo pipefail

FIREFOX_DIR="${HOME}/.var/app/org.mozilla.firefox/.mozilla/firefox"
THEME_REPOSITORY="https://github.com/rafaelmardojai/firefox-gnome-theme.git"

if [[ ! -d "$FIREFOX_DIR" ]]; then
  echo "Firefox directory not found, skipping theme update."
  exit 0
fi

TMPDIR=$(/usr/bin/mktemp -d)
cleanup() {
  /usr/bin/rm -rf "$TMPDIR"
}
trap cleanup EXIT

echo "Updating Firefox GNOME theme..."

/usr/bin/git clone --depth 1 --quiet "$THEME_REPOSITORY" "$TMPDIR/firefox-gnome-theme"

/usr/bin/find "$FIREFOX_DIR" -maxdepth 1 -type d -exec test -d "{}/chrome" \; -print \
  | while read -r profile; do
      target="$profile/chrome/theme"
      /usr/bin/rm -rf "$target"
      /usr/bin/install -d "$target"
      /usr/bin/cp -a "$TMPDIR/firefox-gnome-theme/theme/." "$target/"
      /usr/bin/cp -a "$TMPDIR/firefox-gnome-theme/userChrome.css" "${target%/*}"
      /usr/bin/cp -a "$TMPDIR/firefox-gnome-theme/userContent.css" "${target%/*}"
    done

echo "Firefox GNOME theme updated successfully."
